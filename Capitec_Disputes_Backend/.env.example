# Copy to .env and set real values. .env is gitignored, never commit it.
# docker compose reads this file automatically and substitutes into compose.yaml.

# Signing key for the portal JWTs. At least 32 bytes.
# Generate one: openssl rand -base64 48
JWT_SIGNING_KEY=

# Portal accounts created on startup in Development only.
SEED_ADMIN_EMAIL=admin@capitec.test
SEED_ADMIN_PASSWORD=
SEED_READONLY_EMAIL=readonly@capitec.test
SEED_READONLY_PASSWORD=
