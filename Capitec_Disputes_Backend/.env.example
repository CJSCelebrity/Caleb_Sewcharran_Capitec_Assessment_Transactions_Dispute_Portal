# Copy to .env and set real values. .env is gitignored, never commit it.
# docker compose reads this file automatically and substitutes into compose.yaml.

# Minimum 32 bytes. Generate one with: openssl rand -base64 48
# docker compose fails fast if this is unset.
JWT_SIGNING_KEY=

# Portal accounts are listed in CapitecDisputes.Api/seed-users.csv, not here.
# Copy seed-users.example.csv to that path and fill in the passwords. It is
# gitignored and must never be committed.
#
# The other two seed files hold no secrets and are committed:
#   CapitecDisputes.Api/seed-transactions.csv
#   CapitecDisputes.Api/seed-disputes.csv
#
# All three seeders are Development only and insert-only, so changing a value
# takes effect only after the matching row is removed from the database.
# A full reset is: docker compose down -v
