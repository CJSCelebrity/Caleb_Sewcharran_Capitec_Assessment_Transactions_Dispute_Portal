# Where the dev server proxies /api. Use http://localhost:8080 when the API
# runs under docker compose rather than dotnet run.
VITE_API_PROXY_TARGET=http://localhost:5089

# Base path the API client calls. Leave this alone to use the dev proxy above;
# set an absolute URL only when talking to an API on another origin, which also
# needs a CORS policy on the backend.
# VITE_API_BASE_URL=/api
